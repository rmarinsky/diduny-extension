{
	"name": "diduny-extension",
	"version": "0.1.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt --browser firefox",
		"build": "wxt build",
		"zip": "wxt zip",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"validate": "bun run lint && bun run typecheck"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2",
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/chrome": "^0.0.304",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.1.2",
		"@vitejs/plugin-react": "^4.4.1",
		"@wxt-dev/module-react": "^1.1.3",
		"typescript": "^5.7.3",
		"wxt": "^0.19.25"
	},
	"overrides": {
		"@vitejs/plugin-react": "^4.4.1"
	}
}
