{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"organizeImports": { "enabled": true },
	"linter": {
		"enabled": true,
		"rules": { "recommended": true }
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"files": {
		"ignore": [
			".wxt/",
			"node_modules/",
			"dist/",
			".output/",
			"playwright-report/",
			"test-results/"
		]
	}
}
